{
  "name": "@langyspace/cupom",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "test": "vitest run",
    "test:button-system": "node scripts/audit-button-system.mjs",
    "test:layout": "node scripts/audit-layout.mjs",
    "validate:ui": "pnpm run test:button-system && pnpm test && pnpm run build && LAYOUT_AUDIT_SCREENSHOTS=1 pnpm run test:layout",
    "preview": "vite preview",
    "deploy": "pnpm run validate:ui && npx firebase-tools deploy --only hosting:cupom --project langyspace-564b5",
    "seed:influencers": "node scripts/seed-influencer-links.mjs"
  },
  "dependencies": {
    "@langyspace/ui": "https://github.com/MarcosLaboriosi/langyspace-ui/releases/download/v0.5.0/langyspace-ui-0.5.0.tgz",
    "firebase": "^12.13.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "styled-components": "^6.4.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "playwright": "1.61.0",
    "prettier": "^3.8.3",
    "typescript": "~6.0.2",
    "vite": "^8.0.9",
    "vitest": "^4.1.8"
  }
}
